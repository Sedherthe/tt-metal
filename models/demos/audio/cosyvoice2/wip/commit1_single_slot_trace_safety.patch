--- a/models/demos/audio/cosyvoice2/tests/pcc/test_flow_decoder.py
+++ b/models/demos/audio/cosyvoice2/tests/pcc/test_flow_decoder.py
@@ -327,3 +327,70 @@
     passed, pcc = comp_pcc(want, got, GATE_BF16)
